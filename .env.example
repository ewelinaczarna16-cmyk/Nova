# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Brain (Tier 1) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional fallback provider for when the primary is *down*, not just slow.
# Leave blank to fall back to a secondary Claude model instead of another vendor.
FALLBACK_API_KEY=

# --- Voice (Tier 3) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Heartbeat / notifications (Tier 5) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_TO_NUMBER=
